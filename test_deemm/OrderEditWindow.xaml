<Window x:Class="test_deemm.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о заказе"
        Height="570" Width="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="Times New Roman"
        Background="White" Icon="/Icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="10">
            <TextBlock Text="ИНФОРМАЦИЯ О ЗАКАЗЕ"
                       FontSize="20" FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="5,15">
            <TextBlock Text="Номер заказа"/>
            <TextBox Name="tbNumber" Height="30" IsReadOnly="True"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Товары"/>
            <TextBox Name="tbItems" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Дата заказа"/>
            <DatePicker Name="dpOrderDate" Margin="0,5,0,10"/>

            <TextBlock Text="Дата доставки"/>
            <DatePicker Name="dpDeliveryDate" Margin="0,5,0,10"/>

            <TextBlock Text="Пункт выдачи"/>
            <TextBox Name="tbPvz" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="ФИО клиента"/>
            <TextBox Name="tbClient" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Код получения"/>
            <TextBox Name="tbCode" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Статус"/>
            <ComboBox Name="cbStatus" Height="30" Margin="0,5,0,10">
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="В обработке"/>
                <ComboBoxItem Content="Готов к выдаче"/>
                <ComboBoxItem Content="Выдан"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="35"
                    Margin="5" Background="#00FA9A"
                    Click="btnSave_Click"/>
            <Button Content="Отмена" Width="90" Height="35"
                    Margin="5" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
