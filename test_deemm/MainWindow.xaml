<Window x:Class="test_deemm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Авторизация"
        Height="450" Width="650"
        MinHeight="450" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Times New Roman"
        Icon="/Icon.ico">

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая декоративная часть -->
        <Border Grid.Column="0" Background="#7FFF00">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="20">
                <TextBlock Text="ООО"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#FFFFFF"/>

                <TextBlock Text="«ОБУВЬ»"
                           FontSize="38"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#FFFFFF"
                           Margin="0,5,0,15"/>

                <Border Height="4"
                        Width="90"
                        Background="#00FA9A"
                        HorizontalAlignment="Center"/>

                <TextBlock Text="Магазин обуви"
                           FontSize="19"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- Правая часть: авторизация -->
        <Grid Grid.Column="1" Margin="35">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="АВТОРИЗАЦИЯ"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#2E8B57"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Войдите в свою учетную запись"
                           FontSize="16"
                           Foreground="#555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Логин"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                <TextBox Name="tblog"
                         Height="38"
                         FontSize="16"
                         Padding="8,5"
                         BorderBrush="#7FFF00"
                         BorderThickness="1.5"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Пароль"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                <PasswordBox Name="pBox"
                             Height="38"
                             FontSize="16"
                             Padding="8,5"
                             BorderBrush="#7FFF00"
                             BorderThickness="1.5"
                             Margin="0,0,0,20"/>

                <Button Name="btnLogin"
                        Content="ВОЙТИ"
                        Height="42"
                        FontSize="17"
                        FontWeight="Bold"
                        Background="#00FA9A"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        Click="Button_Click"/>

                <Button Name="btnGuest"
                        Content="ВОЙТИ КАК ГОСТЬ"
                        Height="38"
                        FontSize="16"
                        Background="#FFFFFF"
                        Foreground="#2E8B57"
                        BorderBrush="#7FFF00"
                        BorderThickness="2"
                        Cursor="Hand"
                        Click="btnGuest_Click"/>

                <TextBlock Name="txtStatus"
                           Foreground="Red"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,15,0,0"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
