<Window x:Class="test_deemm.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Заказы"
        Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="#FFFFFF" Icon="/Icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="#7FFF00"
                CornerRadius="8"
                Padding="15">
            <TextBlock Text="ЗАКАЗЫ"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Поиск -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock Text="Поиск:"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox Name="tbSearch"
                     Width="250"
                     Height="30"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"/>

            <Button Content="Найти"
                    Width="80"
                    Height="30"
                    Background="#00FA9A"
                    Click="btnSearch_Click"/>

            <Button Content="Сбросить"
                    Width="90"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="btnReset_Click"/>
        </StackPanel>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="2"
                  Name="gridOrders"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="14"
                  RowHeight="35"
                  AlternatingRowBackground="#F0FFF0">

            <DataGrid.Columns>

                <DataGridTextColumn Header="№ заказа"
                                    Binding="{Binding Order_number}"
                                    Width="80"/>

                <DataGridTextColumn Header="Товары"
                                    Binding="{Binding item_number}"
                                    Width="*"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding Order_date}"
                                    Width="110"/>

                <DataGridTextColumn Header="Дата доставки"
                                    Binding="{Binding delivery_date}"
                                    Width="120"/>

                <DataGridTextColumn Header="Пункт выдачи"
                                    Binding="{Binding address_pvz}"
                                    Width="110"/>

                <DataGridTextColumn Header="ФИО клиента"
                                    Binding="{Binding full_name}"
                                    Width="200"/>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding code}"
                                    Width="70"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding status}"
                                    Width="100"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button Name="btnAdd"
                    Content="Добавить"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Background="#00FA9A"
                    Click="btnAdd_Click"/>

            <Button Name="btnEdit"
                    Content="Изменить"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="btnEdit_Click"/>

            <Button Name="btnDelete"
                    Content="Удалить"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="btnDelete_Click"/>

            <Button Content="Назад"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Background="#7FFF00"
                    Click="btnBack_Click"/>

        </StackPanel>
    </Grid>
</Window>
