<Window x:Class="test_deemm.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО «Обувь» — Каталог"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="#FFFFFF" Icon="/Icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="12">
            <TextBlock Text="ООО «ОБУВЬ» — КАТАЛОГ ТОВАРОВ"
                       FontSize="25" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBox Name="tbSearch" Width="180" Height="30"
                     Margin="0,0,5,0"
                     VerticalContentAlignment="Center"/>

            <Button Content="Поиск" Width="70" Height="30"
                    Background="#00FA9A"
                    Click="btnSearch_Click"/>

            <ComboBox Name="cbCategory" Width="160" Height="30"
                      Margin="15,0,10,0"
                      SelectionChanged="cbCategory_SelectionChanged"/>

            <ComboBox Name="cbSort" Width="180" Height="30"
                      SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию цены"/>
                <ComboBoxItem Content="По убыванию цены"/>
            </ComboBox>

            <Button Name="btnReset" Content="Сбросить"
                    Width="85" Height="30" Margin="10,0,0,0"
                    Click="btnReset_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="gridProducts"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  FontSize="14" RowHeight="65"
                  AlternatingRowBackground="#F0FFF0"
                  LoadingRow="gridProducts_LoadingRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding article}" Width="90"/>

                <DataGridTemplateColumn Header="Фото" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding photo}"
                                   Width="65" Height="55"
                                   Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Product_name}" Width="*"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Product_category}" Width="140"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price}" Width="80"/>

                <DataGridTextColumn Header="Скидка, %"
                                    Binding="{Binding discount}" Width="90"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Kol_vo_na_sklade}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Name="txtCount" Text="Товаров: 0"
                       FontSize="15" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Name="btnOrders" Content="Заказы"
                        Width="90" Height="35" Margin="4"
                        Background="#7FFF00"
                        Click="btnOrders_Click"/>

                <Button Name="btnAdd" Content="Добавить"
                        Width="90" Height="35" Margin="4"
                        Background="#00FA9A"
                        Click="btnAdd_Click"/>

                <Button Name="btnEdit" Content="Изменить"
                        Width="90" Height="35" Margin="4"
                        Click="btnEdit_Click"/>

                <Button Name="btnDelete" Content="Удалить"
                        Width="90" Height="35" Margin="4"
                        Click="btnDelete_Click"/>

                <Button Content="Выход"
                        Width="90" Height="35" Margin="4"
                        Background="#7FFF00"
                        Click="btnExit_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>